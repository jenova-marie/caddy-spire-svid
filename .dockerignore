# 🌸 Docker ignore file for better build caching and smaller context

# Git files
.git/
.gitignore
.gitattributes

# Documentation
*.md
README.md
LICENSE
CHANGELOG.md
docs/
PROJECT_SUMMARY.md

# Development files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files and coverage
*_test.go
testdata/
coverage.out
coverage.html
test-*.sh
debug-*.sh

# Build artifacts (host builds)
bin/
dist/
*.out
*.exe

# Docker files (don't copy other docker configs)
docker-compose*.yml
Dockerfile*
!Dockerfile.caddy

# CI/CD
.github/
.circleci/

# Temporary files
tmp/
temp/
.tmp/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Node.js (if any)
node_modules/
npm-debug.log
yarn-error.log

# Python (if any)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Log files
*.log
logs/

# Environment files
.env
.env.local
.env.*.local

# IDE configs
.vscode/settings.json
.idea/

# Backup files
*.bak
*.backup

# Test binaries we create
cmd/test-*/
cmd/test-*

# Scripts (development only)
scripts/

# Examples (we copy these selectively in Dockerfile)
examples/
!examples/caddyfile-spire-module
!examples/caddy-json-spire-module.json
