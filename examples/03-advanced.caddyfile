# 🌸 Advanced SPIRE Configuration
# Production-ready setup with multiple environments, load balancing, and advanced features

{
    # Global options
    admin localhost:2019
    log {
        output file /var/log/caddy/access.log
        format json
    }
    error_log /var/log/caddy/error.log
    
    # ACME for non-SPIRE domains
    email admin@example.com
    default_sni production.example.com
}

# Production environment with multiple backends
production.example.com {
    tls {
        issuer spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 30s
        }
    }
    
    # Load balancer with health checks
    reverse_proxy /app/* {
        to localhost:3001 localhost:3002 localhost:3003
        lb_policy round_robin
        health_uri /health
        health_interval 30s
        health_timeout 5s
        fail_duration 30s
        
        # Backend headers
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Spiffe-ID {tls_client_certificate_serial}
    }
    
    # Static assets with CDN-like caching
    handle /static/* {
        file_server {
            root /var/www/production
        }
        header {
            Cache-Control "public, max-age=86400"
            ETag {file_hash}
        }
    }
    
    # API with rate limiting
    handle /api/* {
        rate_limit {
            zone api_zone
            key {remote_host}
            events 100
            window 1m
        }
        reverse_proxy localhost:8080
    }
    
    # Default security headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Staging environment with different SPIRE socket
staging.example.com {
    tls {
        issuer spire {
            socket_path /var/run/spire/staging/api.sock
            refresh_interval 60s  # Less frequent refresh in staging
        }
    }
    
    reverse_proxy localhost:3010 {
        header_up X-Environment "staging"
        header_up X-Debug-Mode "true"
    }
    
    # Allow CORS for staging
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }
    
    # Staging banner
    header X-Environment "STAGING"
}

# Internal services with mutual TLS
internal.example.com {
    tls {
        issuer spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 15s  # Frequent refresh for internal services
        }
        client_auth {
            mode require_and_verify
            trusted_ca_certs_file /etc/ssl/certs/spire-ca.pem
        }
    }
    
    # Internal API - requires client certificates
    reverse_proxy localhost:9000 {
        header_up X-Client-Cert {tls_client_certificate_pem}
        header_up X-Client-SPIFFE-ID {tls_client_certificate_subject}
    }
}

# Metrics and monitoring
metrics.example.com {
    tls {
        issuer spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 45s
        }
    }
    
    # Prometheus metrics
    handle /metrics {
        metrics
    }
    
    # Health dashboard
    handle /health/* {
        reverse_proxy localhost:9090
    }
    
    # Require basic auth for metrics
    basicauth {
        admin $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNqBZExw1RdPWJaGDnHkLUTAu
    }
}

# WebSocket service with SPIRE
ws.example.com {
    tls {
        issuer spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 30s
        }
    }
    
    # WebSocket proxy with proper headers
    reverse_proxy localhost:8081 {
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
