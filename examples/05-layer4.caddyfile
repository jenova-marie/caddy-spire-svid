# 🌸 Layer 4 (TCP/UDP) Proxy with SPIRE Integration
# Demonstrates TCP proxying with SPIFFE certificate authentication
# using integrated file-based certificate management

{
    # Global options
    admin localhost:2019
    debug
    # Disable automatic HTTPS for HTTP servers
    auto_https off
    
    # Layer 4 app configuration with SPIRE file-based TLS
    layer4 {
        :1443 {
            @tls tls
            route @tls {
                # Terminate TLS with SPIRE certificates (automatically written by HTTP app)
                tls {
                    cert /tmp/spire-certs/cert.pem
                    key /tmp/spire-certs/key.pem
                }
                # Proxy to backend after TLS termination
                proxy localhost:8080
            }
            
            @http http
            route @http {
                # Direct proxy for non-TLS
                proxy localhost:8080
            }
        }
    }
}



# HTTP backend for demonstration
localhost:8080 {
    respond "🌸 Backend server reached via L4 proxy with SPIFFE security! ✨
Connection type: {method} {uri}
Headers: {header.*}"
}

# Standard HTTPS with SPIRE (automatically writes certs for Layer 4 if env vars set)
localhost:8443 {
    tls {
        get_certificate spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 30s
        }
    }
    
    respond "🌸 HTTPS Backend: SPIFFE-secured Caddy!
Your connection is secured with SPIRE certificates ✨
Layer 4 TLS proxy also available on :1443 (if SPIRE_CERT_FILE and SPIRE_KEY_FILE are set)"
}
