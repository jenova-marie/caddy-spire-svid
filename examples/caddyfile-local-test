# 🌸 Local test Caddyfile for SPIRE integration
# Uses localhost and the domains from your workload entries

# Primary HTTPS test site matching your DNS names
localhost:8443, localhost:8443, localhost:8443 {
    tls {
        get_certificate spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 30s
        }
    }
    
    respond "🌸 Hello from SPIFFE-secured Caddy on {host}! Certificate via SPIRE ✨"
}

# HTTP redirect site
localhost:80, localhost:80, localhost:80 {
    respond "🌸 HTTP Caddy is working! Try HTTPS at port 8443 for SPIRE certificates ✨"
}

# Admin API (for debugging)
:2019 {
    respond "🌸 Caddy Admin API - Access admin at localhost:2019/config ✨"
}
