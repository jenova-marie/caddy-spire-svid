# 🌸 Example Caddyfile using SPIRE certificate issuer module
# This configuration demonstrates Method 1: Caddy Module integration

# Basic SPIFFE-secured site
example.com {
    tls {
        issuer spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 30s
        }
    }
    
    respond "🌸 Hello from SPIFFE-secured Caddy!"
}

# Multiple sites with different SPIRE configurations
api.example.com {
    tls {
        issuer spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 15s
        }
    }
    
    reverse_proxy localhost:8080
}

# Development site with custom socket path
dev.example.com {
    tls {
        issuer spire {
            socket_path /var/run/spire/agent.sock
            refresh_interval 60s
        }
    }
    
    file_server browse
}
