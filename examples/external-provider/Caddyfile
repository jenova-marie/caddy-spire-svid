# 🌸 Example Caddyfile for Method 2: External Certificate Provider
# This configuration uses certificates provided by the external provider service

example.com {
    tls /tmp/caddy-spire-certs/cert.pem /tmp/caddy-spire-certs/key.pem {
        # Reload certificates automatically when they change
        reload_time 30s
    }
    
    respond "🌸 Hello from External SPIFFE Provider!"
}

# Multiple sites using the same external certificates
*.example.com {
    tls /tmp/caddy-spire-certs/cert.pem /tmp/caddy-spire-certs/key.pem {
        reload_time 30s
    }
    
    # Route based on subdomain
    @api host api.example.com
    handle @api {
        reverse_proxy localhost:8080
    }
    
    @www host www.example.com
    handle @www {
        file_server
    }
    
    # Default handler
    respond "🌸 Subdomain: {labels.1}.example.com"
}
