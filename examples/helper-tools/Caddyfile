# 🌸 Example Caddyfile for Method 5: Helper Tools / File-based Integration
# This configuration uses certificates written by the SPIRE helper tool

# Basic configuration using helper-generated certificates
example.com {
    # Use certificates generated by SPIRE helper
    tls /etc/ssl/spire/cert.pem /etc/ssl/spire/key.pem {
        # Reload certificates when they change on disk
        reload_time 10s
    }
    
    respond "🌸 Hello from SPIRE Helper Tool integration!"
}

# Advanced configuration with custom paths
api.example.com {
    # Custom certificate paths (matching helper tool configuration)
    tls /etc/ssl/myapp/server.crt /etc/ssl/myapp/server.key {
        reload_time 15s
        # Optional: specify client CA for mTLS
        # client_ca /etc/ssl/spire/bundle.pem
    }
    
    reverse_proxy localhost:8080 {
        # Pass SPIFFE ID information to backend
        header_up X-Spiffe-ID {tls_client_subject}
    }
}

# Development configuration with local paths
dev.example.com {
    tls ./certs/cert.pem ./certs/key.pem {
        reload_time 5s
    }
    
    file_server browse
}

# Legacy application integration
legacy.example.com {
    # Traditional certificate paths that legacy apps expect
    tls /var/ssl/cert.pem /var/ssl/key.pem {
        reload_time 30s
    }
    
    # Serve static files or proxy to legacy app
    respond "🔧 Legacy application secured with SPIFFE!"
}
