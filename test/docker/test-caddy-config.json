{
  "_comment": "🐳 Docker Test JSON Configuration - Test-specific Caddy config",
  "_description": "Test configuration for Docker/container testing - NOT FOR DOCUMENTATION",
  
  "admin": {
    "listen": "0.0.0.0:2020"
  },
  
  "logging": {
    "logs": {
      "default": {
        "level": "DEBUG",
        "encoder": {
          "format": "json"
        }
      }
    }
  },
  
  "apps": {
    "http": {
      "servers": {
        "test_server": {
          "listen": [":8080", ":8443"],
          "routes": [
            {
              "match": [{"path": ["/"]}],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 200,
                  "headers": {
                    "Content-Type": ["text/plain; charset=utf-8"]
                  },
                  "body": "🐳 Docker Test: SPIFFE-secured Caddy!\nYour connection is secured with SPIRE certificates ✨\nTest suite: Containerized integration testing\n"
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": ["localhost", "test-server"],
            "issuers": [
              {
                "module": "spire",
                "socket_path": "/tmp/spire-agent/public/api.sock",
                "refresh_interval": "30s"
              }
            ]
          }
        ]
      }
    }
  }
}
