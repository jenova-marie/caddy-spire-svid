# 🌸 Docker Test Configuration
# Test-specific Caddyfile for Docker/container testing

{
    # Global options
    admin 0.0.0.0:2019
    debug
    # Disable automatic HTTPS on 80/443
    auto_https off
}

# HTTPS site with SPIRE certificates - TEST PORTS
:8443 {
    tls {
        get_certificate spire {
            socket_path /tmp/spire-agent/public/api.sock
            refresh_interval 30s
        }
    }
    
    respond "🐳 Docker Test: SPIFFE-secured Caddy!
Your connection is secured with SPIRE certificates ✨
Test suite: Containerized integration testing"
}

# Plain HTTP for testing - TEST PORTS
:8080 {
    respond "🐳 Docker Test: HTTP Caddy working!
Visit https://localhost:8443 for SPIRE-secured HTTPS ✨
Test suite: Containerized integration testing"
}
